---
/**
 * 404 — "Ups, verlaufen!"
 *
 * Erstes Spiel „Zombie-Welle“ (seit 03.10.2026 echter 3D-Shooter mit three.js,
 * animierten Zombies, Blut und Pistole): liegt statisch unter
 * public/spiele/zombie-welle/ (Quellcode: spiele-src/zombie-welle/) und wird
 * erst bei Auswahl per iframe geladen (Direktlink #zombie).
 *
 * Seit 30.09.2026 zweites Spiel „Fuchs & Federn“ (Schießbude mit dem
 * 2FOX4-Fuchs, components/arcade/FoxGame.astro) und davor eine
 * Spielauswahl (components/arcade/GamePicker.astro). Umschaltung über
 * data-game an .lost-page ("none" | "zombie" | "fox"), Direktlink per
 * #zombie bzw. #fuchs.
 *
 * Drittes Spiel „Krawumm!“ (Retro-Plattformer, 30.09.2026): liegt statisch
 * unter public/spiele/krawumm/ und wird erst bei Auswahl per iframe geladen
 * (data-game="krawumm", Direktlink #krawumm). Beim Zurück wird das iframe
 * geleert, damit Musik und Spiel sofort stoppen.
 *
 * Apache liefert /404.html bei nicht gefundenen URLs aus (ErrorDocument
 * 404 /404.html steht in der Server-.htaccess).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import GamePicker from "../components/arcade/GamePicker.astro";
import FoxGame from "../components/arcade/FoxGame.astro";

const title = "Ups, verlaufen! — 2fox4";
const description =
  "Diese Seite gibt es nicht. Dafür warten drei kleine Spiele auf dich: Zombie-Welle, Fuchs & Federn und Krawumm!";
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="lost-page" data-game="none">
    <header class="lost-hero">
      <h1 class="lost-title">Ups, verlaufen.</h1>
      <p class="lost-hint">
        Diese Seite gibt es nicht. Zum Trost haben wir drei Spiele für dich.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-sm" href="/">← Zurück zur Startseite</a>
        <button class="btn btn-ghost btn-sm" id="hud-sound" type="button" aria-label="Sound an/aus">
          <span id="sound-icon">🔇</span>&nbsp;Sound:&nbsp;<span id="sound-state">aus</span>
        </button>
      </div>
    </header>

    <GamePicker />

    <div class="game-view" data-view="zombie">
      <div class="game-bar">
        <button class="bar-back" type="button" data-arcade-back>← Spielauswahl</button>
        <p class="bar-hint"><kbd>WASD</kbd> laufen · <kbd>Leertaste</kbd> springen · <kbd>Klick</kbd> schießen · <kbd>1</kbd>–<kbd>3</kbd> Waffen · <kbd>G</kbd> Granate · <kbd>F</kbd> Vollbild</p>
      </div>
      <div class="zw-frame">
        <iframe data-zombie title="Zombie-Welle – 3D-Ego-Shooter" allow="fullscreen; autoplay"></iframe>
      </div>
    </div>

    <div class="game-view" data-view="fox">
      <div class="game-bar">
        <button class="bar-back" type="button" data-arcade-back>← Spielauswahl</button>
        <p class="bar-hint">
          <span class="hint-fine"><kbd>Klick</kbd>: schießen · <kbd>Rechtsklick</kbd>: nachladen · Maus an den Rand: Ansicht schwenken</span>
          <span class="hint-coarse">Tippen: schießen · Patronen antippen: nachladen</span>
        </p>
      </div>
      <FoxGame />
    </div>

    <div class="game-view" data-view="krawumm">
      <div class="game-bar">
        <button class="bar-back" type="button" data-arcade-back>← Spielauswahl</button>
        <p class="bar-hint">
          <span class="hint-fine"><kbd>A</kbd>&thinsp;<kbd>D</kbd> laufen · <kbd>Leertaste</kbd> springen · <kbd>X</kbd> ballern · <kbd>P</kbd> Pause · <kbd>M</kbd> Musik</span>
          <span class="hint-coarse">Tasten im Bild: laufen, springen, feuern</span>
        </p>
      </div>
      <div class="krawumm-frame">
        <iframe data-krawumm title="Krawumm! – Retro-Plattformer" allow="autoplay; fullscreen"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0.75rem 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lost-hero {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: center;
    margin-bottom: 0.2rem;
  }
  .lost-title {
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 800;
  }
  .lost-hint {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Spielauswahl / Ansichten */
  .game-view { display: none; flex-direction: column; gap: 0.5rem; }
  .lost-page[data-game="zombie"] .game-view[data-view="zombie"],
  .lost-page[data-game="fox"] .game-view[data-view="fox"],
  .lost-page[data-game="krawumm"] .game-view[data-view="krawumm"] { display: flex; }
  .krawumm-frame {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #07060d;
    box-shadow: 0 25px 60px -20px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .krawumm-frame iframe { display: block; width: 100%; height: 100%; border: 0; }
  .zw-frame {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #050506;
    box-shadow: 0 25px 60px -20px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .zw-frame iframe { display: block; width: 100%; height: 100%; border: 0; }
  .lost-page:not([data-game="none"]) :global([data-arcade-picker]) { display: none; }
  .game-bar {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .bar-back {
    display: inline-flex;
    align-items: center;
    padding: 0.32rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-card);
    color: var(--color-text);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .bar-back:hover, .bar-back:focus-visible { border-color: var(--color-accent); color: var(--color-accent); }
  .bar-hint { margin: 0; font-size: 0.8rem; color: var(--color-text-muted); }
  .hint-coarse { display: none; }
  @media (pointer: coarse) {
    .hint-fine { display: none; }
    .hint-coarse { display: inline; }
  }
  kbd {
    font-family: "JetBrains Mono Variable", monospace;
    background: #f3f4f6;
    border: 1px solid #d1d5db;
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0 5px;
    margin: 0 1px;
    font-size: 0.82em;
    color: #111827;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    border: 1px solid transparent;
    text-decoration: none;
    transition: transform 0.1s, background 0.15s;
    font-family: inherit;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn-sm { padding: 0.3rem 0.8rem; font-size: 0.82rem; }
  .btn-primary { background: #b91c1c; color: #fff; }
  .btn-primary:hover { background: #991b1b; }
  .btn-ghost {
    background: transparent;
    color: #111827;
    border-color: #d1d5db;
  }
  .btn-ghost:hover { background: #f3f4f6; }
  .btn-lg { padding: 0.7rem 1.2rem; font-size: 1rem; }

  .hero-actions {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-top: 0.15rem;
  }
  #hud-sound {
    cursor: pointer;
    background: #fbbf24;
    color: #111827;
    border-color: #d97706;
    font-weight: 700;
  }
  #hud-sound:hover { background: #f59e0b; }
  #hud-sound.sound-off {
    background: #e5e7eb;
    border-color: #9ca3af;
    color: #374151;
  }
  #hud-sound.sound-off:hover { background: #d1d5db; }
</style>

<script is:inline>
  /* Sound-Knopf oben: gilt für alle Spiele (Zombie-Welle liest denselben Wert). */
  (function () {
    "use strict";
    const btn = document.getElementById("hud-sound");
    if (!btn) return;
    const icon = document.getElementById("sound-icon");
    const state = document.getElementById("sound-state");
    const read = () => { try { return localStorage.getItem("fps_sound_v1") === "1"; } catch (e) { return false; } };
    function render() {
      const on = read();
      icon.textContent = on ? "🔊" : "🔇";
      state.textContent = on ? "an" : "aus";
      btn.classList.toggle("sound-off", !on);
    }
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      try { localStorage.setItem("fps_sound_v1", read() ? "0" : "1"); } catch (e2) {}
      render();
    });
    // Änderungen aus dem Spiel-iframe (gleiche Domain) kommen als storage-Event an
    window.addEventListener("storage", (e) => { if (e.key === "fps_sound_v1") render(); });
    render();
  })();
</script>

<script is:inline>
  /* Spielauswahl: schaltet zwischen Auswahl, Zombie-Welle und Fuchs & Federn um. */
  (function () {
    "use strict";
    const page = document.querySelector(".lost-page");
    if (!page) return;
    const HASH = { zombie: "#zombie", fox: "#fuchs", krawumm: "#krawumm" };
    const FROM_HASH = { "#zombie": "zombie", "#fuchs": "fox", "#krawumm": "krawumm" };
    const kFrame = page.querySelector("[data-krawumm]");
    const K_SRC = "/spiele/krawumm/";
    const zFrame = page.querySelector("[data-zombie]");
    const Z_SRC = "/spiele/zombie-welle/";

    function zombie(on) {
      if (!zFrame) return;
      if (on) {
        if (zFrame.getAttribute("src") !== Z_SRC) {
          zFrame.setAttribute("src", Z_SRC);
          zFrame.addEventListener("load", () => { try { zFrame.contentWindow.focus(); } catch (e) {} }, { once: true });
        }
        zFrame.focus();
      } else if (zFrame.getAttribute("src")) {
        zFrame.src = "about:blank";
        zFrame.removeAttribute("src");
      }
    }

    function krawumm(on) {
      if (!kFrame) return;
      if (on) {
        if (kFrame.getAttribute("src") !== K_SRC) {
          kFrame.setAttribute("src", K_SRC);
          kFrame.addEventListener("load", () => { try { kFrame.contentWindow.focus(); } catch (e) {} }, { once: true });
        }
        kFrame.focus();
      } else if (kFrame.getAttribute("src")) {
        kFrame.removeAttribute("src");
        kFrame.src = "about:blank";
        kFrame.removeAttribute("src");
      }
    }

    function showBest() {
      let best = 0;
      try { best = parseInt(localStorage.getItem("foxhunt_best_v1") || "0", 10) || 0; } catch (e) {}
      document.querySelectorAll("[data-fox-best]").forEach((el) => {
        el.hidden = best <= 0;
        const b = el.querySelector("b");
        if (b) b.textContent = String(best);
      });
      let kBest = 0;
      try { kBest = parseInt(localStorage.getItem("krawumm_hi") || "0", 10) || 0; } catch (e) {}
      document.querySelectorAll("[data-krawumm-best]").forEach((el) => {
        el.hidden = kBest <= 0;
        const b = el.querySelector("b");
        if (b) b.textContent = String(kBest);
      });
    }

    function select(game, silent) {
      page.dataset.game = game;
      krawumm(game === "krawumm");
      zombie(game === "zombie");
      window.dispatchEvent(new CustomEvent("arcade:select", { detail: game }));
      try {
        history.replaceState(null, "", location.pathname + location.search + (HASH[game] || ""));
      } catch (e) {}
      showBest();
      if (silent) return;
      if (game === "none") {
        const picker = page.querySelector("[data-arcade-picker]");
        picker && picker.scrollIntoView({ behavior: "smooth", block: "nearest" });
        const first = page.querySelector("[data-pick]");
        first && first.focus({ preventScroll: true });
      } else {
        const view = page.querySelector('.game-view[data-view="' + game + '"]');
        view && view.scrollIntoView({ behavior: "smooth", block: "nearest" });
        const btn = view && view.querySelector('#btn-start, [data-fx-action="start"]');
        btn && btn.focus({ preventScroll: true });
      }
    }

    page.addEventListener("click", (e) => {
      const pick = e.target.closest("[data-pick]");
      if (pick) { select(pick.dataset.pick); return; }
      if (e.target.closest("[data-arcade-back]")) select("none");
    });

    window.addEventListener("keydown", (e) => {
      if (page.dataset.game !== "none" || e.altKey || e.ctrlKey || e.metaKey) return;
      if (e.key === "1") select("zombie");
      if (e.key === "2") select("fox");
      if (e.key === "3") select("krawumm");
    });

    // Karten leicht kippen, wenn die Maus darüber fährt
    page.querySelectorAll("[data-pick]").forEach((card) => {
      card.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse") return;
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.setProperty("--ry", (x * 10).toFixed(2) + "deg");
        card.style.setProperty("--rx", (-y * 8).toFixed(2) + "deg");
      });
      card.addEventListener("pointerleave", () => {
        card.style.removeProperty("--rx");
        card.style.removeProperty("--ry");
      });
    });

    window.addEventListener("fox:record", showBest);
    showBest();
    const initial = FROM_HASH[location.hash];
    if (initial) select(initial, true);
  })();
</script>
