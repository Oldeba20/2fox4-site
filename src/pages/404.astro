---
/**
 * 404 — "Ups, verlaufen!"
 *
 * Zombie-Welle (3D-Ego-Shooter): am 03.10.2026 wegen Jugendschutz entfernt,
 * seit 04.10.2026 als v2 zurück – in der jugendfreien Glitch-Darstellung
 * (kein Blut, Gegner zerfallen in Pixel). Der Hart-Modus ist auf der Website
 * gesperrt (<body data-hardmode="off"> in public/spiele/zombie-welle/index.html).
 * Quellcode: spiele-src/zombie-welle/ (Build: npm run build), Direktlink
 * #zombie, Taste 5, nur Desktop.
 *
 * Seit 30.09.2026 zweites Spiel „Fuchs & Federn“ (Schießbude mit dem
 * 2FOX4-Fuchs, components/arcade/FoxGame.astro) und davor eine
 * Spielauswahl (components/arcade/GamePicker.astro). Umschaltung über
 * data-game an .lost-page ("none" | "fox" | "krawumm"), Direktlink per
 * #fuchs bzw. #krawumm.
 *
 * Drittes Spiel „Krawumm!“ (Retro-Plattformer, 30.09.2026): liegt statisch
 * unter public/spiele/krawumm/ und wird erst bei Auswahl per iframe geladen
 * (data-game="krawumm", Direktlink #krawumm). Beim Zurück wird das iframe
 * geleert, damit Musik und Spiel sofort stoppen.
 *
 * Weiteres Spiel „Fuchs-Flitzer“ (3D-Kartrennen mit dem 2FOX4-Fuchs,
 * 03.10.2026): statisch unter public/spiele/fuchs-flitzer/, Quellcode in
 * spiele-src/fuchs-flitzer/ (Three.js, Build: build.sh). Lädt erst bei
 * Auswahl per iframe (data-game="flitzer", Direktlink #flitzer).
 *
 * Orbit-Fuchs (Röhren-Shooter, 04.10.2026): public/spiele/orbit-fuchs/, Kopie in
 * spiele-src/orbit-fuchs/ (kein Build nötig), Direktlink #orbit, Taste 4.
 *
 * Apache liefert /404.html bei nicht gefundenen URLs aus (ErrorDocument
 * 404 /404.html steht in der Server-.htaccess).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import GamePicker from "../components/arcade/GamePicker.astro";
import FoxGame from "../components/arcade/FoxGame.astro";

const title = "Ups, verlaufen! — 2fox4";
const description =
  "Diese Seite gibt es nicht. Dafür warten fünf kleine Spiele auf dich: Fuchs & Federn, Krawumm!, Fuchs-Flitzer, Orbit-Fuchs und Zombie-Welle.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="lost-page" data-game="none">
    <header class="lost-hero">
      <h1 class="lost-title">Ups, verlaufen.</h1>
      <p class="lost-hint">
        Diese Seite gibt es nicht. Zum Trost haben wir fünf Spiele für dich.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-sm" href="/">← Zurück zur Startseite</a>
        <button class="btn btn-ghost btn-sm" id="hud-sound" type="button" aria-label="Sound an/aus">
          <span id="sound-icon">🔇</span>&nbsp;Sound:&nbsp;<span id="sound-state">aus</span>
        </button>
      </div>
    </header>

    <GamePicker />

    <div class="game-view" data-view="fox">
      <button class="mclose" type="button" data-arcade-back aria-label="Spiel beenden">✕</button>
      <div class="game-bar">
        <button class="bar-back" type="button" data-arcade-back>← Spielauswahl</button>
        <p class="bar-hint">
          <span class="hint-fine"><kbd>Klick</kbd>: schießen · <kbd>Rechtsklick</kbd>: nachladen · Maus an den Rand: Ansicht schwenken</span>
          <span class="hint-coarse">Tippen: schießen · Patronen antippen: nachladen</span>
        </p>
      </div>
      <FoxGame />
    </div>

    <div class="game-view" data-view="krawumm">
      <button class="mclose" type="button" data-arcade-back aria-label="Spiel beenden">✕</button>
      <div class="game-bar">
        <button class="bar-back" type="button" data-arcade-back>← Spielauswahl</button>
        <p class="bar-hint">
          <span class="hint-fine"><kbd>A</kbd>&thinsp;<kbd>D</kbd> laufen · <kbd>Leertaste</kbd> springen · <kbd>X</kbd> ballern · <kbd>P</kbd> Pause · <kbd>M</kbd> Musik</span>
          <span class="hint-coarse">Tasten im Bild: laufen, springen, feuern</span>
        </p>
      </div>
      <div class="krawumm-frame">
        <iframe data-krawumm title="Krawumm! – Retro-Plattformer" allow="autoplay; fullscreen"></iframe>
      </div>
    </div>

    <div class="game-view" data-view="orbit">
      <button class="mclose" type="button" data-arcade-back aria-label="Spiel beenden">✕</button>
      <div class="game-bar">
        <button class="bar-back" type="button" data-arcade-back>← Spielauswahl</button>
        <p class="bar-hint">
          <span class="hint-fine"><kbd>Pfeile</kbd> oder <kbd>Maus</kbd> fliegen · <kbd>Leertaste</kbd>/<kbd>Klick</kbd> feuern · <kbd>P</kbd> Pause · <kbd>M</kbd> Ton</span>
          <span class="hint-coarse">Finger auf den Bildschirm: fliegen und feuern</span>
        </p>
      </div>
      <div class="krawumm-frame">
        <iframe data-orbit title="Orbit-Fuchs – Weltraum-Shooter" allow="autoplay; fullscreen"></iframe>
      </div>
    </div>

    <div class="game-view" data-view="flitzer">
      <button class="mclose" type="button" data-arcade-back aria-label="Spiel beenden">✕</button>
      <div class="game-bar">
        <button class="bar-back" type="button" data-arcade-back>← Spielauswahl</button>
        <p class="bar-hint">
          <span class="hint-fine"><kbd>W</kbd>&thinsp;<kbd>A</kbd>&thinsp;<kbd>S</kbd>&thinsp;<kbd>D</kbd> fahren · <kbd>Leertaste</kbd> driften · <kbd>E</kbd> Item · <kbd>P</kbd> Pause</span>
          <span class="hint-coarse">Gas geht automatisch · Pfeile lenken · DRIFT halten für Turbo</span>
        </p>
      </div>
      <div class="krawumm-frame">
        <iframe data-flitzer title="Fuchs-Flitzer – 3D-Kartrennen" allow="autoplay; fullscreen; gamepad"></iframe>
      </div>
    </div>

    <div class="game-view" data-view="zombie">
      <button class="mclose" type="button" data-arcade-back aria-label="Spiel beenden">✕</button>
      <div class="game-bar">
        <button class="bar-back" type="button" data-arcade-back>← Spielauswahl</button>
        <p class="bar-hint">
          <span class="hint-fine"><kbd>WASD</kbd> laufen · <kbd>Leertaste</kbd> springen · <kbd>Klick</kbd> schießen · <kbd>1</kbd>–<kbd>3</kbd> Waffen · <kbd>G</kbd> Granate · <kbd>F</kbd> Vollbild</span>
          <span class="hint-coarse">Nur am Rechner spielbar (Maus + Tastatur)</span>
        </p>
      </div>
      <div class="krawumm-frame">
        <iframe data-zombie title="Zombie-Welle – 3D-Ego-Shooter" allow="autoplay; fullscreen"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0.75rem 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lost-hero {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: center;
    margin-bottom: 0.2rem;
  }
  .lost-title {
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 800;
  }
  .lost-hint {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Spielauswahl / Ansichten */
  .game-view { display: none; flex-direction: column; gap: 0.5rem; }
  .lost-page[data-game="fox"] .game-view[data-view="fox"],
  .lost-page[data-game="krawumm"] .game-view[data-view="krawumm"],
  .lost-page[data-game="flitzer"] .game-view[data-view="flitzer"],
  .lost-page[data-game="orbit"] .game-view[data-view="orbit"],
  .lost-page[data-game="zombie"] .game-view[data-view="zombie"] { display: flex; }
  .krawumm-frame {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #07060d;
    box-shadow: 0 25px 60px -20px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .krawumm-frame iframe { display: block; width: 100%; height: 100%; border: 0; }
  /* Handy: Spiele als Vollbild-Ebene über der ganzen Seite, immer Querformat, nichts scrollt.
     Größe + Drehung setzt das Skript (Klasse mfull, im Hochformat zusätzlich is-rot). */
  .game-view.mfull {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 2147483000;
    padding: 0;
    gap: 0;
    background: #07060d;
    touch-action: none;
    overscroll-behavior: none;
    transform-origin: 0 0;
    container-type: size;
  }
  .game-view.mfull .game-bar { display: none; }
  .game-view.mfull .krawumm-frame {
    max-width: none;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    border-radius: 0;
    box-shadow: none;
  }
  .game-view.mfull :global(.fx) { width: 100%; height: 100%; align-items: center; background: #0b0918; }
  .game-view.mfull :global(.fx-frame) { width: min(100cqw, 160cqh); max-width: none; border-radius: 0; box-shadow: none; }
  .game-view.mfull :global(.fx-card-fox),
  .game-view.mfull :global(.fx-sub),
  .game-view.mfull :global(.fx-portrait) { display: none; }
  .game-view.mfull :global(.fx-card) { padding: 0.7rem 1rem 0.8rem; }
  .game-view.mfull :global(.fx-rules) { font-size: 0.78rem; margin: 0.3rem 0 0.6rem; }
  .game-view.mfull :global(.fx-card h2) { margin: 0 0 0.2rem; font-size: 1.3rem; }
  .mclose {
    display: none;
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 10;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 2px solid rgba(255, 255, 255, 0.75);
    background: rgba(20, 16, 30, 0.55);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    padding: 0;
  }
  .game-view.mfull .mclose { display: grid; place-items: center; }
  .game-view.mfull[data-view="flitzer"] .mclose { display: none; }
  .game-view.mfull[data-view="krawumm"] .mclose { top: auto; bottom: 46%; left: 8px; }
  :global(html.arcade-lock), :global(html.arcade-lock body) { overflow: hidden !important; overscroll-behavior: none; }
  .lost-page:not([data-game="none"]) :global([data-arcade-picker]) { display: none; }
  .game-bar {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .bar-back {
    display: inline-flex;
    align-items: center;
    padding: 0.32rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-card);
    color: var(--color-text);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .bar-back:hover, .bar-back:focus-visible { border-color: var(--color-accent); color: var(--color-accent); }
  .bar-hint { margin: 0; font-size: 0.8rem; color: var(--color-text-muted); }
  .hint-coarse { display: none; }
  @media (pointer: coarse) {
    .hint-fine { display: none; }
    .hint-coarse { display: inline; }
  }
  kbd {
    font-family: "JetBrains Mono Variable", monospace;
    background: #f3f4f6;
    border: 1px solid #d1d5db;
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0 5px;
    margin: 0 1px;
    font-size: 0.82em;
    color: #111827;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    border: 1px solid transparent;
    text-decoration: none;
    transition: transform 0.1s, background 0.15s;
    font-family: inherit;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn-sm { padding: 0.3rem 0.8rem; font-size: 0.82rem; }
  .btn-primary { background: #b91c1c; color: #fff; }
  .btn-primary:hover { background: #991b1b; }
  .btn-ghost {
    background: transparent;
    color: #111827;
    border-color: #d1d5db;
  }
  .btn-ghost:hover { background: #f3f4f6; }
  .btn-lg { padding: 0.7rem 1.2rem; font-size: 1rem; }

  .hero-actions {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-top: 0.15rem;
  }
  #hud-sound {
    cursor: pointer;
    background: #fbbf24;
    color: #111827;
    border-color: #d97706;
    font-weight: 700;
  }
  #hud-sound:hover { background: #f59e0b; }
  #hud-sound.sound-off {
    background: #e5e7eb;
    border-color: #9ca3af;
    color: #374151;
  }
  #hud-sound.sound-off:hover { background: #d1d5db; }
</style>

<script is:inline>
  /* Sound-Knopf oben: gilt für alle Spiele. */
  (function () {
    "use strict";
    const btn = document.getElementById("hud-sound");
    if (!btn) return;
    const icon = document.getElementById("sound-icon");
    const state = document.getElementById("sound-state");
    const read = () => { try { return localStorage.getItem("fps_sound_v1") === "1"; } catch (e) { return false; } };
    function render() {
      const on = read();
      icon.textContent = on ? "🔊" : "🔇";
      state.textContent = on ? "an" : "aus";
      btn.classList.toggle("sound-off", !on);
    }
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      try { localStorage.setItem("fps_sound_v1", read() ? "0" : "1"); } catch (e2) {}
      render();
    });
    // Änderungen aus dem Spiel-iframe (gleiche Domain) kommen als storage-Event an
    window.addEventListener("storage", (e) => { if (e.key === "fps_sound_v1") render(); });
    render();
  })();
</script>

<script is:inline>
  /* Spielauswahl: schaltet zwischen Auswahl, Fuchs & Federn und Krawumm um. */
  (function () {
    "use strict";
    const page = document.querySelector(".lost-page");
    if (!page) return;
    const HASH = { fox: "#fuchs", krawumm: "#krawumm", flitzer: "#flitzer", orbit: "#orbit", zombie: "#zombie" };
    const FROM_HASH = { "#fuchs": "fox", "#krawumm": "krawumm", "#flitzer": "flitzer", "#orbit": "orbit", "#zombie": "zombie" };
    const kFrame = page.querySelector("[data-krawumm]");
    const K_SRC = "/spiele/krawumm/";
    const F_SRC = "/spiele/fuchs-flitzer/";
    const O_SRC = "/spiele/orbit-fuchs/";
    const Z_SRC = "/spiele/zombie-welle/";

    function frame(kFrame, K_SRC, on) {
      if (!kFrame) return;
      if (on) {
        if (kFrame.getAttribute("src") !== K_SRC) {
          kFrame.setAttribute("src", K_SRC);
          kFrame.addEventListener("load", () => { try { kFrame.contentWindow.focus(); } catch (e) {} }, { once: true });
        }
        kFrame.focus();
      } else if (kFrame.getAttribute("src")) {
        kFrame.removeAttribute("src");
        kFrame.src = "about:blank";
        kFrame.removeAttribute("src");
      }
    }

    // Handy: jedes Spiel als Vollbild-Ebene, immer im Querformat (im Hochformat um 90° gedreht),
    // Seite dahinter gesperrt. Android bekommt zusätzlich echtes Vollbild + Querformat-Sperre.
    const coarse = window.matchMedia("(pointer: coarse)").matches;
    let fullView = null;
    function layoutFull() {
      if (!fullView) return;
      const vv = window.visualViewport;
      const w = Math.round(vv ? vv.width : window.innerWidth);
      const h = Math.round(vv ? vv.height : window.innerHeight);
      const rot = h > w;
      fullView.style.width = (rot ? h : w) + "px";
      fullView.style.height = (rot ? w : h) + "px";
      fullView.style.transform = rot ? "translateX(" + w + "px) rotate(90deg)" : "";
      fullView.classList.toggle("is-rot", rot);
      window.dispatchEvent(new Event("resize-arcade"));
    }
    window.addEventListener("resize", layoutFull);
    window.addEventListener("orientationchange", () => { setTimeout(layoutFull, 150); setTimeout(layoutFull, 600); });
    if (window.visualViewport) window.visualViewport.addEventListener("resize", layoutFull);
    function blockScroll(e) { if (!e.target.closest(".fx-ov")) e.preventDefault(); }
    function mobileFull(game) {
      if (!coarse) return;
      if (fullView) {
        fullView.classList.remove("mfull", "is-rot");
        fullView.style.width = fullView.style.height = fullView.style.transform = "";
        fullView.removeEventListener("touchmove", blockScroll);
        fullView = null;
      }
      const on = game !== "none";
      document.documentElement.classList.toggle("arcade-lock", on);
      if (on) {
        fullView = page.querySelector('.game-view[data-view="' + game + '"]');
        if (fullView) {
          fullView.classList.add("mfull");
          fullView.addEventListener("touchmove", blockScroll, { passive: false });
          layoutFull();
        }
        window.scrollTo(0, 0);
      }
      try {
        // Vollbild auf <html> (nicht auf die Ebene selbst), sonst würde der Browser die Drehung im Hochformat aufheben
        const root = document.documentElement;
        if (on && fullView && root.requestFullscreen && !document.fullscreenElement) {
          root.requestFullscreen({ navigationUI: "hide" }).then(() => {
            try { screen.orientation && screen.orientation.lock && screen.orientation.lock("landscape").catch(() => {}); } catch (e) {}
            setTimeout(layoutFull, 100);
          }).catch(() => {});
        } else if (!on && document.fullscreenElement) {
          document.exitFullscreen().catch(() => {});
        }
      } catch (e) {}
    }
    window.addEventListener("message", (e) => {
      if (e.origin !== location.origin || !e.data) return;
      if (e.data.type === "fuchsflitzer:close") select("none");
    });
    function showBest() {
      let best = 0;
      try { best = parseInt(localStorage.getItem("foxhunt_best_v1") || "0", 10) || 0; } catch (e) {}
      document.querySelectorAll("[data-fox-best]").forEach((el) => {
        el.hidden = best <= 0;
        const b = el.querySelector("b");
        if (b) b.textContent = String(best);
      });
      let fBest = 0;
      try { fBest = parseFloat(localStorage.getItem("fk_best") || "0") || 0; } catch (e) {}
      document.querySelectorAll("[data-flitzer-best]").forEach((el) => {
        el.hidden = fBest <= 0;
        const b = el.querySelector("b");
        if (b) { const m = Math.floor(fBest / 60), sec = fBest - m * 60; b.textContent = m + ":" + (sec < 10 ? "0" : "") + sec.toFixed(2); }
      });
      let oBest = 0;
      try { oBest = parseInt(localStorage.getItem("orbit_hi") || "0", 10) || 0; } catch (e) {}
      document.querySelectorAll("[data-orbit-best]").forEach((el) => {
        el.hidden = oBest <= 0;
        const b = el.querySelector("b");
        if (b) b.textContent = String(oBest);
      });
      let kBest = 0;
      try { kBest = parseInt(localStorage.getItem("krawumm_hi") || "0", 10) || 0; } catch (e) {}
      document.querySelectorAll("[data-krawumm-best]").forEach((el) => {
        el.hidden = kBest <= 0;
        const b = el.querySelector("b");
        if (b) b.textContent = String(kBest);
      });
    }

    function select(game, silent) {
      page.dataset.game = game;
      frame(kFrame, K_SRC, game === "krawumm");
      frame(page.querySelector("[data-flitzer]"), F_SRC, game === "flitzer");
      frame(page.querySelector("[data-orbit]"), O_SRC, game === "orbit");
      frame(page.querySelector("[data-zombie]"), Z_SRC, game === "zombie");
      mobileFull(game);
      window.dispatchEvent(new CustomEvent("arcade:select", { detail: game }));
      try {
        history.replaceState(null, "", location.pathname + location.search + (HASH[game] || ""));
      } catch (e) {}
      showBest();
      if (silent) return;
      if (game === "none") {
        const picker = page.querySelector("[data-arcade-picker]");
        picker && picker.scrollIntoView({ behavior: "smooth", block: "nearest" });
        const first = page.querySelector("[data-pick]");
        first && first.focus({ preventScroll: true });
      } else {
        const view = page.querySelector('.game-view[data-view="' + game + '"]');
        if (!coarse) view && view.scrollIntoView({ behavior: "smooth", block: "nearest" });
        const btn = view && view.querySelector('#btn-start, [data-fx-action="start"]');
        btn && btn.focus({ preventScroll: true });
      }
    }

    page.addEventListener("click", (e) => {
      const pick = e.target.closest("[data-pick]");
      if (pick) { select(pick.dataset.pick); return; }
      if (e.target.closest("[data-arcade-back]")) select("none");
    });

    window.addEventListener("keydown", (e) => {
      if (page.dataset.game !== "none" || e.altKey || e.ctrlKey || e.metaKey) return;
      if (e.key === "1") select("fox");
      if (e.key === "2") select("krawumm");
      if (e.key === "3") select("flitzer");
      if (e.key === "4") select("orbit");
      if (e.key === "5") select("zombie");
    });

    // Karten leicht kippen, wenn die Maus darüber fährt
    page.querySelectorAll("[data-pick]").forEach((card) => {
      card.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse") return;
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.setProperty("--ry", (x * 10).toFixed(2) + "deg");
        card.style.setProperty("--rx", (-y * 8).toFixed(2) + "deg");
      });
      card.addEventListener("pointerleave", () => {
        card.style.removeProperty("--rx");
        card.style.removeProperty("--ry");
      });
    });

    window.addEventListener("fox:record", showBest);
    window.addEventListener("storage", (e) => { if (e.key === "fk_best" || e.key === "orbit_hi") showBest(); });
    showBest();
    const initial = FROM_HASH[location.hash];
    if (initial) select(initial, true);
  })();
</script>
