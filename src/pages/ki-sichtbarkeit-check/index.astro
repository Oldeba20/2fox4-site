---
/**
 * /ki-sichtbarkeit-check/ — kostenloses Tool: Wie gut wird ein Unternehmen
 * von KI-Suchmaschinen (ChatGPT, Perplexity, Gemini, Claude) gefunden?
 *
 * MVP: Backend-Check läuft über Perplexity Sonar (public/ki-check.php).
 * Ablauf im Frontend (3 Schritte):
 *   1. Nutzer gibt Firmenname, Leistung/Suchbegriff und Region ein.
 *   2. Tool generiert die echten Käuferfragen und zeigt sie transparent an
 *      (kostenlos, keine API-Kosten).
 *   3. E-Mail-Schranke: Erst nach E-Mail + Einwilligung läuft der Live-Check
 *      gegen die KI-Suche, dann Score + Handlungsempfehlung.
 *
 * Diese Seite ist gleichzeitig SEO/GEO-Ranking-Seite (generische Anfragen
 * wie „werde ich von ChatGPT gefunden") und das Ziel der Facebook-Ads.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQ from "../../components/FAQ.astro";
import CTASection from "../../components/CTASection.astro";
import SearchShiftInfographic from "../../components/SearchShiftInfographic.astro";
import { faqSchema, breadcrumbSchema } from "../../lib/schema";
import { site } from "../../data/site";

const title = "KI-Sichtbarkeit prüfen: kostenloser Check für ChatGPT & Co.";
const description =
  "Kostenloser KI-Sichtbarkeits-Check: Prüfe in einer Minute, ob ChatGPT, Perplexity & Co. dein Unternehmen empfehlen – mit Score und ausführlicher Auswertung per E-Mail.";

const ogImage = "/uploads/ki-check/og.jpg";

const faqItems = [
  {
    question: "Was ist KI-Sichtbarkeit?",
    answerText:
      "KI-Sichtbarkeit beschreibt, ob und wie oft ein Unternehmen in den Antworten von KI-Suchmaschinen wie ChatGPT, Perplexity, Gemini oder den KI-Übersichten bei Google genannt, empfohlen oder als Quelle verlinkt wird. Anders als beim klassischen Google-Ranking gibt es keine Liste mit zehn Plätzen: Entweder die KI nennt dich in ihrer Antwort – oder deine Kunden erfahren gar nicht, dass es dich gibt.",
  },
  {
    question: "Wie kann ich meine KI-Sichtbarkeit prüfen?",
    answerText:
      "Am einfachsten mit diesem kostenlosen Check: Firmenname, Leistung und Region eingeben, und das Tool stellt der KI-Suche acht typische Käuferfragen. Du siehst sofort einen Score, die ausführliche Auswertung kommt per E-Mail. Von Hand geht es auch: Stell ChatGPT oder Perplexity die Fragen, die deine Kunden stellen würden, und notiere, ob du genannt wirst – das dauert aber deutlich länger und ist schwer vergleichbar.",
  },
  {
    question: "Wie kann ich meine KI-Sichtbarkeit verbessern?",
    answerText:
      "Die wichtigsten Hebel: Leistungen klar und konkret beschreiben (was, für wen, wo, zu welchem Preis), Fragen deiner Kunden direkt auf der Website beantworten, strukturierte Daten einbauen, einheitliche Firmendaten in Verzeichnissen und im Google-Unternehmensprofil pflegen und Erwähnungen auf anderen Websites aufbauen. KI-Systeme empfehlen, was sie eindeutig zuordnen und in mehreren Quellen bestätigt finden.",
  },
  {
    question: "Wie funktioniert der KI-Sichtbarkeits-Check?",
    answerText:
      "Du gibst deinen Firmennamen, deine Leistung und deine Region ein. Das Tool formuliert daraus die echten Fragen, die deine Kunden einer KI stellen würden, und schickt sie an eine KI-Suchmaschine. Anschließend prüft es, ob und wie dein Unternehmen in den Antworten auftaucht – und gibt dir einen Score samt Handlungsempfehlung.",
  },
  {
    question: "Welche KI-Suchmaschinen werden geprüft?",
    answerText:
      "Der Check fragt Perplexity und ChatGPT, beide mit Live-Websuche – also so, wie deine Kunden diese Dienste heute nutzen. In der Auswertung siehst du das Ergebnis für jede KI einzeln. Gemini ist als nächste Prüf-Engine geplant.",
  },
  {
    question: "Ist der Check wirklich kostenlos?",
    answerText:
      "Ja. Der Check ist kostenlos. Auf der Seite siehst du sofort eine Vorschau mit deinem Score; die vollständige Auswertung mit allen Fragen und Empfehlungen schicken wir dir nach kurzer Bestätigung (Double-Opt-in) per E-Mail. Es entstehen keine Kosten und keine Verpflichtung.",
  },
  {
    question: "Warum sehe ich die Fragen, bevor der Check startet?",
    answerText:
      "Transparenz: Du sollst genau sehen, welche Fragen wir der KI in deinem Namen stellen. Die Fragen entsprechen der Art, wie echte Interessenten heute nach Anbietern suchen – in ganzen Sätzen statt einzelner Stichworte.",
  },
  {
    question: "Stimmt das Ergebnis exakt mit der ChatGPT-App überein?",
    answerText:
      "Es ist ein sehr starker Indikator, aber keine hundertprozentige Kopie. Die KI-Antworten schwanken von Abfrage zu Abfrage und hängen von Personalisierung ab. Deshalb stellen wir acht unterschiedlich formulierte Fragen und werten das Gesamtbild aus.",
  },
  {
    question: "Was passiert mit meinen Daten?",
    answerText:
      "Wir speichern deine Eingaben und deine E-Mail-Adresse, um den Check durchzuführen und dir die Auswertung per E-Mail zuzustellen. Die Adresse nutzen wir erst, nachdem du sie per Double-Opt-in bestätigt hast – so kann niemand eine fremde Adresse eintragen. Es erfolgt keine Weitergabe an Dritte zu Werbezwecken. Details stehen in unseren Datenschutzhinweisen.",
  },
];

const schema = [
  breadcrumbSchema([
    { name: "Start", url: "/" },
    { name: "KI-Sichtbarkeits-Check", url: "/ki-sichtbarkeit-check/" },
  ]),
  faqSchema(faqItems),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "KI-Sichtbarkeits-Check",
    url: new URL("/ki-sichtbarkeit-check/", site.url).href,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
    description,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/ki-sichtbarkeit-check/"
  ogImage={ogImage}
  schema={schema}
>
  <Breadcrumb
    crumbs={[
      { label: "Start", href: "/" },
      { label: "KI-Sichtbarkeits-Check", href: "/ki-sichtbarkeit-check/" },
    ]}
  />

  <!-- ===================== HERO + TOOL ===================== -->
  <section class="container-content pt-6 pb-16 md:pt-10 md:pb-24">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="inline-block rounded-full border border-[var(--color-border)] px-4 py-1 text-[12px] font-medium uppercase tracking-[0.18em] text-[var(--color-accent)]"
      >
        Kostenloser KI-Sichtbarkeits-Check
      </span>
      <h1 class="mt-5 text-[34px] font-bold leading-[1.1] md:text-[52px]">
        KI-Sichtbarkeit prüfen: Wirst du von
        <span class="text-[var(--color-accent)]">ChatGPT &amp; Co.</span> gefunden?
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-[17px] leading-relaxed text-[var(--color-text-muted)] md:text-[19px]">
        Immer mehr Kunden suchen Anbieter nicht mehr bei Google, sondern fragen
        KI-Suchmaschinen wie ChatGPT, Perplexity, Gemini und Claude. Prüfe in einer
        Minute, ob dein Unternehmen dort empfohlen wird – kostenlos, mit Score und
        konkreter Handlungsempfehlung.
      </p>
    </div>

    <!-- TOOL-KARTE -->
    <div
      id="ki-tool"
      class="mx-auto mt-10 max-w-2xl rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6 md:p-8"
    >
      <!-- Schritt 1: Eingabe -->
      <form id="kic-form" novalidate>
        <div class="grid gap-4">
          <label class="block text-left">
            <span class="text-[14px] font-medium">Dein Firmenname</span>
            <input
              type="text"
              name="business"
              required
              autocomplete="organization"
              placeholder="z. B. Mustermann Steuerberatung"
              class="mt-1 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-[15px] outline-none focus:border-[var(--color-accent)]"
            />
          </label>
          <label class="block text-left">
            <span class="text-[14px] font-medium">Was bietest du an?</span>
            <input
              type="text"
              name="service"
              required
              placeholder="z. B. Steuerberatung, Webdesign, Heizungsbau"
              class="mt-1 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-[15px] outline-none focus:border-[var(--color-accent)]"
            />
          </label>
          <label class="block text-left">
            <span class="text-[14px] font-medium">
              Region / Stadt
              <span class="text-[var(--color-text-muted)]">(optional – für lokale Suche)</span>
            </span>
            <input
              type="text"
              name="region"
              placeholder="z. B. Stadthagen, Region Hannover"
              class="mt-1 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-[15px] outline-none focus:border-[var(--color-accent)]"
            />
          </label>
          <label class="block text-left">
            <span class="text-[14px] font-medium">
              Deine Website-Domain
              <span class="text-[var(--color-text-muted)]">(optional – macht „verlinkt“ genauer)</span>
            </span>
            <input
              type="text"
              name="domain"
              inputmode="url"
              autocomplete="url"
              placeholder="z. B. mustermann-steuerberatung.de"
              class="mt-1 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-[15px] outline-none focus:border-[var(--color-accent)]"
            />
          </label>
          <!-- Honeypot (für Menschen unsichtbar) -->
          <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;overflow:hidden;">
            <label>Website (bitte leer lassen)
              <input type="text" name="company_url" tabindex="-1" autocomplete="off" />
            </label>
          </div>
          <button
            type="submit"
            class="mt-1 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[var(--color-accent)] px-6 py-3.5 text-[15px] font-semibold text-black transition-all hover:-translate-y-px"
          >
            Weiter: Fragen ansehen →
          </button>
          <p class="text-center text-[12px] text-[var(--color-text-muted)]">
            Schritt 1 von 2 · Im nächsten Schritt siehst du die Fragen, bevor der Check startet.
          </p>
        </div>
      </form>

      <!-- Schritt 2: Generierte Fragen + E-Mail-Schranke -->
      <div id="kic-step2" hidden class="mt-2">
        <p class="text-left text-[14px] text-[var(--color-text-muted)]">
          Schritt 2 von 2 · Diese Käuferfragen stellen wir der KI-Suche in deinem Namen:
        </p>
        <ol id="kic-questions" class="mt-3 grid gap-2 text-left"></ol>

        <div class="mt-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5">
          <p class="text-left text-[14px] font-medium">
            Wohin sollen wir deine Auswertung schicken?
          </p>
          <p class="mt-1 text-left text-[12px] text-[var(--color-text-muted)]">
            Auf der Seite siehst du gleich eine kurze Vorschau. Deine vollständige,
            aufbereitete Auswertung bekommst du per E-Mail – nach kurzer Bestätigung.
          </p>
          <label for="kic-email" class="sr-only">E-Mail-Adresse für die Auswertung</label>
          <input
            id="kic-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="deine@firma.de"
            class="mt-2 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-4 py-3 text-[15px] outline-none focus:border-[var(--color-accent)]"
          />
          <label class="mt-3 flex items-start gap-2 text-left text-[13px] text-[var(--color-text-muted)]">
            <input id="kic-consent" type="checkbox" class="mt-1" />
            <span>
              Schickt mir meine Auswertung per E-Mail und verarbeitet dafür meine
              Eingaben. Zur Bestätigung erhalte ich zuerst eine Double-Opt-in-Mail;
              erst nach meinem Klick folgt die Auswertung, die auch einen Hinweis auf
              ein Beratungsangebot enthalten kann
              (<a href="/datenschutz/" class="underline hover:text-[var(--color-text)]">Datenschutz</a>).
            </span>
          </label>
          <label class="mt-3 flex items-start gap-2 text-left text-[13px] text-[var(--color-text-muted)]">
            <input id="kic-newsletter" type="checkbox" class="mt-1" />
            <span>
              <span class="text-[var(--color-text)]">Freiwillig:</span>
              Ja, schickt mir etwa einmal im Monat Neuigkeiten und Tipps zur KI-Sichtbarkeit
              und zu Angeboten von 2FOX4 per E-Mail. Abmelden kann ich mich jederzeit mit einem Klick.
            </span>
          </label>
          <button
            id="kic-run"
            type="button"
            class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[var(--color-accent)] px-6 py-3.5 text-[15px] font-semibold text-black transition-all hover:-translate-y-px disabled:opacity-50"
          >
            Auswertung kostenlos anfordern
          </button>
          <p class="mt-2 text-center text-[12px] text-[var(--color-text-muted)]">
            Kostenlos · keine Verpflichtung · Vorschau in unter einer Minute, Details per E-Mail
          </p>
        </div>
        <button id="kic-back" type="button" class="mt-3 text-[13px] text-[var(--color-text-muted)] underline">
          ← Eingaben ändern
        </button>
      </div>

      <!-- Lade-Zustand -->
      <div id="kic-loading" hidden class="py-10 text-center" role="status" aria-live="polite">
        <div class="kic-spinner mx-auto"></div>
        <p id="kic-loading-text" class="mt-4 text-[15px] text-[var(--color-text-muted)]">
          Wir fragen gerade die KI-Suche …
        </p>
      </div>

      <!-- Schritt 3: Ergebnis -->
      <div id="kic-result" hidden></div>

      <!-- Fehler -->
      <div id="kic-error" role="alert" aria-live="assertive" hidden class="mt-4 rounded-lg border border-[var(--color-accent)] bg-[var(--color-bg)] p-4 text-[14px]"></div>
    </div>

    <p class="mx-auto mt-4 max-w-2xl text-center text-[12px] text-[var(--color-text-muted)]">
      Hinweis: Das Ergebnis ist ein starker Indikator für deine KI-Sichtbarkeit,
      keine garantierte 1:1-Abbildung der jeweiligen App.
    </p>
  </section>

  <!-- ===================== SO FUNKTIONIERT'S ===================== -->
  <section class="border-t border-[var(--color-border)] py-16 md:py-20">
    <div class="container-content">
      <h2 class="text-center text-[26px] font-bold md:text-[34px]">So funktioniert der Check</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
          <div class="text-[28px] font-bold text-[var(--color-accent)]">1</div>
          <h3 class="mt-2 text-[18px] font-semibold">Suchbegriff eingeben</h3>
          <p class="mt-2 text-[15px] text-[var(--color-text-muted)]">
            Firmenname, Leistung und (optional) Region eingeben. Mehr braucht es nicht.
          </p>
        </div>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
          <div class="text-[28px] font-bold text-[var(--color-accent)]">2</div>
          <h3 class="mt-2 text-[18px] font-semibold">Echte Fragen an die KI</h3>
          <p class="mt-2 text-[15px] text-[var(--color-text-muted)]">
            Das Tool formuliert die Fragen, die deine Kunden wirklich stellen, und
            schickt sie an die KI-Suche. Du siehst jede Frage transparent.
          </p>
        </div>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
          <div class="text-[28px] font-bold text-[var(--color-accent)]">3</div>
          <h3 class="mt-2 text-[18px] font-semibold">Score &amp; Empfehlung</h3>
          <p class="mt-2 text-[15px] text-[var(--color-text-muted)]">
            Du erfährst, ob und wie du genannt wirst – plus konkrete nächste Schritte,
            um sichtbarer zu werden.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SUCH-VERSCHIEBUNG (INFOGRAFIK) ===================== -->
  <SearchShiftInfographic />

  <!-- ===================== RANKING-CONTENT ===================== -->
  <section class="border-t border-[var(--color-border)] py-16 md:py-20">
    <div class="container-content mx-auto max-w-3xl">
      <h2 class="text-[26px] font-bold md:text-[34px]">Was ist KI-Sichtbarkeit?</h2>
      <div class="mt-6 grid gap-5 text-[16px] leading-relaxed text-[var(--color-text-muted)]">
        <p>
          <strong class="text-[var(--color-text)]">KI-Sichtbarkeit</strong> beschreibt, ob ein
          Unternehmen in den Antworten von KI-Suchmaschinen wie ChatGPT, Perplexity, Gemini oder
          den KI-Übersichten bei Google auftaucht – als Empfehlung mit Namen oder als verlinkte Quelle.
          Statt zehn blauer Links zu vergleichen, stellen immer mehr Menschen ihre Frage direkt einer
          KI und bekommen eine fertige Antwort mit zwei, drei Anbietern. Stehst du dort nicht drin,
          verlierst du Anfragen, von denen du nie erfährst.
        </p>
        <p>
          Die Arbeit daran heißt <strong class="text-[var(--color-text)]">GEO – Generative Engine
          Optimization</strong>. Sie baut auf klassischer Suchmaschinenoptimierung auf, hat aber ein
          anderes Ziel: nicht Platz 1 in einer Trefferliste, sondern die Nennung in der Antwort selbst.
          Welche drei Stufen der KI-Sichtbarkeit es gibt, erklären wir im Beitrag
          <a href="/blog/geo-ki-suche-marketing-3-stufen-sichtbarkeit/" class="text-[var(--color-accent)] underline">GEO: die 3 Stufen der KI-Sichtbarkeit</a>.
        </p>
      </div>

      <h2 class="mt-14 text-[26px] font-bold md:text-[34px]">KI-Sichtbarkeit messen: So entsteht dein Score</h2>
      <div class="mt-6 grid gap-5 text-[16px] leading-relaxed text-[var(--color-text-muted)]">
        <p>
          Der Check stellt Perplexity und ChatGPT je acht Fragen, wie sie Interessenten tatsächlich formulieren –
          etwa „Wer sind die besten Anbieter für Webdesign in Stadthagen?“. Jede Antwort wird
          auf zweierlei Weise ausgewertet:
        </p>
        <ul class="grid gap-3 pl-5" style="list-style: disc;">
          <li><strong class="text-[var(--color-text)]">Genannt:</strong> Dein Firmenname taucht im Antworttext auf. Das zählt am meisten, denn so sieht der Kunde dich.</li>
          <li><strong class="text-[var(--color-text)]">Verlinkt:</strong> Deine Website steht unter den Quellen, auf die sich die KI stützt. Mit Angabe deiner Domain erkennt der Check das besonders genau.</li>
        </ul>
        <p>
          Aus allen Antworten ergibt sich ein Wert zwischen 0 und 100 Prozent. Weil KI-Antworten
          von Abfrage zu Abfrage schwanken, ist das ein Indikator und keine exakte Messung. Wiederholst
          du den Check in ein paar Wochen, siehst du trotzdem gut, ob sich etwas bewegt. Welche
          weiteren Kennzahlen es gibt und wie du sie selbst verfolgst, steht im Leitfaden
          <a href="/blog/sichtbarkeit-in-ki-suchmaschinen-messen/" class="text-[var(--color-accent)] underline">KI-Sichtbarkeit messen: Kennzahlen und Tools</a>.
        </p>
      </div>

      <h2 class="mt-14 text-[26px] font-bold md:text-[34px]">KI-Sichtbarkeit verbessern: die wichtigsten Hebel</h2>
      <ol class="mt-6 grid gap-4 pl-5 text-[16px] leading-relaxed text-[var(--color-text-muted)]" style="list-style: decimal;">
        <li><strong class="text-[var(--color-text)]">Klar sagen, was du anbietest.</strong> Leistung, Zielgruppe, Einzugsgebiet und ungefähre Preise gehören ausdrücklich auf die Website – KI-Systeme empfehlen, was sie eindeutig zuordnen können.</li>
        <li><strong class="text-[var(--color-text)]">Fragen deiner Kunden beantworten.</strong> Eine gut gepflegte FAQ und Seiten, die typische Fragen direkt beantworten, liefern der KI zitierfähige Sätze.</li>
        <li><strong class="text-[var(--color-text)]">Strukturierte Daten einbauen.</strong> Schema.org-Angaben zu Unternehmen, Leistungen und Standort machen deine Seite maschinenlesbar.</li>
        <li><strong class="text-[var(--color-text)]">Einheitliche Firmendaten im Netz.</strong> Name, Adresse und Telefonnummer sollten im Google-Unternehmensprofil, in Branchenverzeichnissen und auf der Website identisch sein.</li>
        <li><strong class="text-[var(--color-text)]">Erwähnungen auf anderen Seiten.</strong> Bewertungen, Presseartikel und Fachbeiträge bestätigen der KI, dass du eine relevante Adresse bist.</li>
      </ol>
      <div class="mt-6 grid gap-5 text-[16px] leading-relaxed text-[var(--color-text-muted)]">
        <p>
          Dazu kommt eine neue Käuferschicht: KI-Agenten, die Anbieter selbständig recherchieren und
          vergleichen, bevor ein Mensch deine Website öffnet. Warum deine Seite dafür
          <a href="/blog/ki-agenten-als-kaeufer-website-maschinenlesbar/" class="text-[var(--color-accent)] underline">maschinenlesbar sein muss</a>,
          liest du in unserem Beitrag dazu. Willst du gezielt sichtbarer werden, ist unsere
          <a href="/leistungen/seo/" class="text-[var(--color-accent)] underline">SEO- &amp; KI-Sichtbarkeits-Leistung</a>
          der nächste Schritt.
        </p>
        <p>
          <a href="#ki-tool" class="font-semibold text-[var(--color-accent)] underline">Jetzt KI-Sichtbarkeit kostenlos prüfen ↑</a>
        </p>
      </div>
    </div>
  </section>

  <FAQ items={faqItems} title="Häufige Fragen zum KI-Sichtbarkeits-Check." />

  <CTASection title="Unsichtbar in der KI-Suche? Lass uns das ändern." />
</BaseLayout>

<style>
  .kic-spinner {
    width: 42px;
    height: 42px;
    border: 4px solid var(--color-border);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: kic-spin 0.8s linear infinite;
  }
  @keyframes kic-spin {
    to { transform: rotate(360deg); }
  }
  .kic-ring {
    width: 132px;
    height: 132px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin: 0 auto;
  }
  .kic-ring > div {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    background: var(--color-bg-elevated);
    display: grid;
    place-items: center;
    font-size: 30px;
    font-weight: 700;
  }
  .kic-qrow {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 12px 0;
    border-top: 1px solid var(--color-border);
  }
  .kic-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .kic-badge.yes { background: var(--color-accent); color: #000; }
  .kic-badge.no { background: var(--color-border); color: var(--color-text-muted); }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById("kic-form");
    if (!form) return;
    var step2 = document.getElementById("kic-step2");
    var qList = document.getElementById("kic-questions");
    var loading = document.getElementById("kic-loading");
    var loadingText = document.getElementById("kic-loading-text");
    var result = document.getElementById("kic-result");
    var errorBox = document.getElementById("kic-error");
    var runBtn = document.getElementById("kic-run");
    var backBtn = document.getElementById("kic-back");
    var emailEl = document.getElementById("kic-email");
    var consentEl = document.getElementById("kic-consent");
    var newsletterEl = document.getElementById("kic-newsletter");

    // Endpoint relativ zur Seite (funktioniert auch unter /neu/-Preview):
    // Seite liegt unter /ki-sichtbarkeit-check/ → ../ki-check.php = /ki-check.php
    var ENDPOINT = new URL("../ki-check.php", window.location.href).href;

    var state = { business: "", service: "", region: "", domain: "", questions: [] };
    var startedAt = Date.now();

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    // Fragen-Generator — IDENTISCH zu kic_build_questions() in public/lib/ki-check-detect.php
    function buildQuestions(service, region) {
      var s = service.trim();
      var r = region.trim();
      if (r) {
        return [
          "Wer sind die besten Anbieter für " + s + " in " + r + "?",
          "Welche Firmen für " + s + " kannst du mir in " + r + " empfehlen?",
          "Ich suche " + s + " in " + r + " – wen würdest du empfehlen?",
          "Was ist eine gute Adresse für " + s + " im Raum " + r + "?",
          "Nenne mir seriöse Anbieter für " + s + " in " + r + ".",
          "Welcher Anbieter für " + s + " in " + r + " hat besonders gute Bewertungen?",
          "Welcher Anbieter für " + s + " in " + r + " hat ein gutes Preis-Leistungs-Verhältnis?",
          "Welchen erfahrenen Experten für " + s + " in " + r + " kannst du empfehlen?",
        ];
      }
      return [
        "Wer sind die besten Anbieter für " + s + "?",
        "Welche Firmen für " + s + " kannst du mir empfehlen?",
        "Ich suche einen Anbieter für " + s + " – wen würdest du empfehlen?",
        "Was sind führende Unternehmen im Bereich " + s + "?",
        "Nenne mir seriöse Anbieter für " + s + ".",
        "Welcher Anbieter für " + s + " hat besonders gute Bewertungen?",
        "Welcher Anbieter für " + s + " hat ein gutes Preis-Leistungs-Verhältnis?",
        "Welchen erfahrenen Experten für " + s + " kannst du empfehlen?",
      ];
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var fd = new FormData(form);
      // Honeypot
      if ((fd.get("company_url") || "").toString().trim() !== "") return;
      state.business = (fd.get("business") || "").toString().trim();
      state.service = (fd.get("service") || "").toString().trim();
      state.region = (fd.get("region") || "").toString().trim();
      state.domain = (fd.get("domain") || "").toString().trim();
      if (state.business.length < 2 || state.service.length < 2) {
        showError("Bitte gib mindestens Firmenname und Leistung ein.");
        return;
      }
      hideError();
      state.questions = buildQuestions(state.service, state.region);
      qList.innerHTML = state.questions
        .map(function (q) {
          return (
            '<li class="flex gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2 text-[14px]">' +
            '<span class="text-[var(--color-accent)]">›</span><span>' +
            esc(q) +
            "</span></li>"
          );
        })
        .join("");
      form.hidden = true;
      step2.hidden = false;
      step2.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });

    // Enter im E-Mail-Feld startet den Check (Feld liegt nicht in einem <form>)
    emailEl.addEventListener("keydown", function (e) {
      if (e.key === "Enter") {
        e.preventDefault();
        runBtn.click();
      }
    });

    backBtn.addEventListener("click", function () {
      step2.hidden = true;
      form.hidden = false;
    });

    runBtn.addEventListener("click", function () {
      var email = (emailEl.value || "").trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError("Bitte gib eine gültige E-Mail-Adresse ein.");
        return;
      }
      if (!consentEl.checked) {
        showError("Bitte bestätige die Verarbeitung deiner Daten.");
        return;
      }
      hideError();
      step2.hidden = true;
      loading.hidden = false;
      cycleLoading();

      fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          business: state.business,
          service: state.service,
          region: state.region,
          domain: state.domain,
          email: email,
          consent: true,
          newsletter: newsletterEl.checked,
          elapsed_ms: Date.now() - startedAt,
        }),
      })
        .then(function (res) {
          return res.json().catch(function () {
            throw new Error("Unerwartete Antwort vom Server.");
          });
        })
        .then(function (data) {
          loading.hidden = true;
          if (!data || data.ok !== true) {
            throw new Error((data && data.error) || "Der Check ist fehlgeschlagen.");
          }
          // Meta-Pixel: Lead melden. fbq existiert nur nach Marketing-Zustimmung
          // (FacebookPixel.astro), ohne Zustimmung passiert hier also nichts.
          try {
            if (typeof window.fbq === "function") {
              window.fbq("track", "Lead", { content_name: "KI-Sichtbarkeits-Check" });
            }
          } catch (e) {}
          renderResult(data);
        })
        .catch(function (err) {
          loading.hidden = true;
          step2.hidden = false;
          showError(err.message || "Es ist ein Fehler aufgetreten. Bitte später erneut versuchen.");
        });
    });

    var loadingMsgs = [
      "Wir fragen gerade die KI-Suche …",
      "Die KI recherchiert live im Web …",
      "Wir prüfen, ob du genannt wirst …",
      "Gleich ist dein Ergebnis fertig …",
    ];
    function cycleLoading() {
      var i = 0;
      loadingText.textContent = loadingMsgs[0];
      var t = setInterval(function () {
        if (loading.hidden) {
          clearInterval(t);
          return;
        }
        i = (i + 1) % loadingMsgs.length;
        loadingText.textContent = loadingMsgs[i];
      }, 4000);
    }

    // Gleiche Ampel wie in der Auswertungsmail (kicheck_score_color)
    function ringColor(score) {
      if (score >= 67) return "#22a06b";
      if (score >= 34) return "var(--color-accent)";
      return "#e5484d";
    }

    function renderResult(data) {
      var score = Math.max(0, Math.min(100, Math.round(data.score || 0)));
      var email = esc(data.email || "");

      // Hinweis-Box je nach Zustellweg
      var mailBox;
      if (data.result_emailed) {
        mailBox =
          '<p class="text-[15px] font-semibold text-[var(--color-text)]">Deine vollständige Auswertung ist unterwegs ✉️</p>' +
          '<p class="mt-2 text-[14px] text-[var(--color-text-muted)]">Wir haben sie gerade an <strong class="text-[var(--color-text)]">' +
          email +
          "</strong> geschickt – mit allen geprüften Fragen, Erklärungen und deinen nächsten Schritten. Schau in dein Postfach.</p>";
      } else if (data.confirmation_sent) {
        mailBox =
          '<p class="text-[15px] font-semibold text-[var(--color-text)]">Nur noch ein Klick zu deiner vollständigen Auswertung ✉️</p>' +
          '<p class="mt-2 text-[14px] text-[var(--color-text-muted)]">Wir haben dir eine kurze Bestätigungsmail an <strong class="text-[var(--color-text)]">' +
          email +
          "</strong> geschickt. Bestätige den Link darin – direkt danach erhältst du deine vollständige, aufbereitete Auswertung per E-Mail.</p>";
      } else if (data.pending_updated) {
        mailBox =
          '<p class="text-[15px] font-semibold text-[var(--color-text)]">Bestätigungsmail liegt schon in deinem Postfach ✉️</p>' +
          '<p class="mt-2 text-[14px] text-[var(--color-text-muted)]">Wir haben dir vor Kurzem bereits eine Bestätigungsmail an <strong class="text-[var(--color-text)]">' +
          email +
          "</strong> geschickt. Klick auf den Link darin – du bekommst dann die Auswertung dieses neuen Checks. Schau auch im Spam-Ordner nach.</p>";
      } else if (data.mail_error) {
        mailBox =
          '<p class="text-[15px] font-semibold text-[var(--color-text)]">Die E-Mail konnten wir gerade nicht verschicken</p>' +
          '<p class="mt-2 text-[14px] text-[var(--color-text-muted)]">Dein Score oben ist gültig. Für die ausführliche Auswertung schreib uns kurz über das <a href="/kontakt/" class="underline">Kontaktformular</a> oder ruf an – wir schicken sie dir persönlich.</p>';
      } else {
        mailBox =
          '<p class="text-[15px] font-semibold text-[var(--color-text)]">Deine vollständige Auswertung kommt per E-Mail ✉️</p>' +
          '<p class="mt-2 text-[14px] text-[var(--color-text-muted)]">Bitte prüfe dein Postfach (' +
          email +
          ") und bestätige kurz den Link – danach senden wir dir alle Details.</p>";
      }

      result.innerHTML =
        '<div class="text-center">' +
        '<div class="kic-ring" style="background: conic-gradient(' +
        ringColor(score) +
        " " +
        score +
        "%, var(--color-border) 0);\">" +
        '<div>' + score + "%</div></div>" +
        '<p class="mt-3 text-[18px] font-semibold">' + esc(data.level || "") + "</p>" +
        '<p class="mx-auto mt-1 max-w-md text-[14px] text-[var(--color-text-muted)]">' +
        esc(data.summary || "") +
        "</p>" +
        (Array.isArray(data.engines) && data.engines.length
          ? '<p class="mx-auto mt-3 max-w-md text-[13px] text-[var(--color-text-muted)]">Befragt: ' +
            data.engines.map(function (e) { return esc(e.label) + ' <strong class="text-[var(--color-text)]">' + e.mentions + '/' + e.n + '</strong>'; }).join(' · ') +
            ' Antworten mit Nennung</p>'
          : '') +
        (data.competitors_ahead > 0
          ? '<p class="mx-auto mt-4 max-w-md rounded-lg border border-[var(--color-accent)] px-4 py-3 text-[14px] font-semibold text-[var(--color-text)]">' +
            (data.competitors_ahead === 1 ? '1 Mitbewerber wird' : data.competitors_ahead + ' Mitbewerber werden') +
            ' von der KI häufiger genannt als du. Wer das ist, steht in deiner Auswertung per E-Mail.</p>'
          : '') +
        '<p class="mx-auto mt-2 max-w-md text-[12px] text-[var(--color-text-faint)]">Das ist eine kurze Vorschau. Die ausführliche Auswertung mit allen Fragen und Empfehlungen erhältst du per E-Mail.</p>' +
        "</div>" +
        '<div class="mt-6 rounded-xl border border-[var(--color-accent)] bg-[var(--color-bg)] p-5 text-center">' +
        mailBox +
        "</div>" +
        '<a href="/kontakt/" class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-[var(--color-accent)] px-6 py-3.5 text-[15px] font-semibold text-black transition-all hover:-translate-y-px">Kostenloses Gespräch zur KI-Sichtbarkeit</a>' +
        '<button type="button" id="kic-again" class="mt-3 w-full text-center text-[13px] text-[var(--color-text-muted)] underline">Weiteren Check starten (z. B. andere Leistung oder Region)</button>';
      result.hidden = false;
      result.scrollIntoView({ behavior: "smooth", block: "start" });
      var again = document.getElementById("kic-again");
      if (again) {
        again.addEventListener("click", function () {
          result.hidden = true;
          result.innerHTML = "";
          form.hidden = false;
          form.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      }
    }

    function showError(msg) {
      errorBox.textContent = msg;
      errorBox.hidden = false;
    }
    function hideError() {
      errorBox.hidden = true;
    }
  })();
</script>
