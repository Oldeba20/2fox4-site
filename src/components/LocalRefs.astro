---
/**
 * LocalRefs — Sektion mit lokalen Referenzen einer Stadt.
 * 2-Spalten-Grid aus MonitorCards.
 */
import MonitorCard from "./MonitorCard.astro";
import { references } from "../data/references";

export interface LocalRef {
  url: string;
  image: string;
  /** Slug der zugehörigen Referenz in references.ts. Nur wenn dort `featured: true`
   *  gesetzt ist, wird die Karte klickbar — sonst Schaufenster-Tile. */
  href: string;
  tag: string; // z. B. "Vereins-Website · Stadthagen"
  title: string;
  description: string;
}

/** Zugehörige Referenz aus references.ts (über den Slug im href). */
function findRef(href: string) {
  const slug = href.replace(/^\/referenzen\//, "").replace(/\/$/, "");
  return slug ? references.find((r) => r.slug === slug) : undefined;
}

/** Prüft, ob der Ref-Slug eine featured Case-Study hat. */
function isFeatured(href: string): boolean {
  return !!findRef(href)?.featured;
}

interface Props {
  city: string;
  refs: LocalRef[];
}

const { city, refs } = Astro.props;
---

<section class="border-y border-[var(--color-border)] bg-[var(--color-bg-elevated)] py-16">
  <div class="container-content">
    <div class="mb-3.5 text-xs uppercase tracking-[0.16em] text-[var(--color-accent)]">
      {city}er Referenzen
    </div>
    <h2 class="mb-3.5 text-[clamp(28px,3.5vw,44px)] font-bold tracking-[-0.03em] leading-[1.1]">
      Wir kennen {city} — und {city} kennt uns.
    </h2>
    <p class="mb-10 max-w-[640px] text-[17px] text-[var(--color-text-muted)]">
      Aktuelle Projekte aus {city} und der näheren Umgebung. So wissen wir, was
      hier funktioniert und welche Themen lokale Unternehmen wirklich beschäftigen.
    </p>

    <div class="grid gap-6 md:grid-cols-2">
      {refs.map((ref) => (
        <MonitorCard
          url={ref.url}
          image={ref.image}
          alt={`Website-Vorschau: ${ref.title} (${ref.tag})`}
          href={isFeatured(ref.href) ? ref.href : undefined}
          variant="compact"
          mobileImage={findRef(ref.href)?.mobileImage}
          phoneSizes="(min-width: 768px) 125px, 85px"
        >
          <div class="mb-2 text-[11px] uppercase tracking-[0.12em] text-[var(--color-accent)]">
            {ref.tag}
          </div>
          <h3 class="mb-1 text-[19px] font-semibold tracking-[-0.01em]">
            {ref.title}
          </h3>
          <p class="text-sm text-[var(--color-text-muted)]">{ref.description}</p>
          {(isFeatured(ref.href) || findRef(ref.href)?.liveUrl) && (
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] font-medium">
              {isFeatured(ref.href) && (
                <a href={ref.href} class="text-[var(--color-accent)] hover:underline">
                  Case Study lesen →
                </a>
              )}
              {findRef(ref.href)?.liveUrl && (
                <a
                  href={findRef(ref.href)!.liveUrl}
                  target="_blank"
                  rel="noopener"
                  class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
                  aria-label={`${ref.title} live ansehen (öffnet in neuem Tab)`}
                >
                  Live ansehen ↗
                </a>
              )}
            </div>
          )}
        </MonitorCard>
      ))}
    </div>
  </div>
</section>
