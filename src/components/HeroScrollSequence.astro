---
/**
 * HeroScrollSequence — Vollflächiger Scroll-Film als Hero-Hintergrund.
 *
 * Motiv: Kamerafahrt durch ein dunkles Studio auf einen Laptop mit
 * Quellcode zu; beim Hineinfliegen wird aus dem Code eine fertige Website.
 * Die linke Hälfte des Schlussbilds ist bewusst leer — dort steht dann die
 * echte H1, als wäre sie die Überschrift dieser Website.
 *
 * Technik: WebP-Einzelbilder, per Canvas passend zur Scrollposition gezeichnet.
 * - Text (Slot) ist echtes HTML über dem Film -> SEO, Barrierefreiheit.
 * - Erstes Bild als <img> (LCP). Restliche Frames erst nach dem Laden.
 * - Querformat: 16:9-Frames (1920 px). Hochformat: eigene, auf den Laptop
 *   zugeschnittene Frames, damit am Handy nichts Wichtiges abgeschnitten wird.
 * - Die Sektion ist höher als der Bildschirm; der Inhalt bleibt "gepinnt"
 *   (sticky), bis der Film durch ist.
 * - prefers-reduced-motion / Datensparmodus: nur das Standbild.
 */
interface Props {
  alt: string;
  desktop: { path: string; count: number; width: number; height: number };
  mobile: { path: string; count: number; width: number; height: number };
}
const { alt, desktop, mobile } = Astro.props;
const first = (p: string) => `${p}/0001.webp`;
---

<section
  class="hss-section"
  data-hss
  data-d-path={desktop.path}
  data-d-count={desktop.count}
  data-m-path={mobile.path}
  data-m-count={mobile.count}
>
  <div class="hss-pin">
    <div class="hss-bg" aria-hidden="false">
      <picture>
        <source media="(max-aspect-ratio: 1/1)" srcset={first(mobile.path)} width={mobile.width} height={mobile.height} />
        <img
          class="hss-poster"
          src={first(desktop.path)}
          alt={alt}
          width={desktop.width}
          height={desktop.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <canvas class="hss-canvas" aria-hidden="true"></canvas>
      <span class="hss-scrim" aria-hidden="true"></span>
    </div>

    <div class="hss-content container-content relative z-10 w-full">
      <slot />
    </div>
  </div>
</section>

<script>
  function initHeroSequence(el: HTMLElement) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const saveData = (navigator as any).connection?.saveData === true;
    if (reduce || saveData) return;

    const portrait = window.matchMedia("(max-aspect-ratio: 1/1)").matches;
    const path = portrait ? el.dataset.mPath! : el.dataset.dPath!;
    const count = Number(portrait ? el.dataset.mCount : el.dataset.dCount);
    const canvas = el.querySelector<HTMLCanvasElement>(".hss-canvas")!;
    const ctx = canvas.getContext("2d");
    if (!ctx || !count) return;

    const frames: (HTMLImageElement | null)[] = new Array(count).fill(null);
    let current = -1;
    let ticking = false;
    const src = (i: number) => `${path}/${String(i + 1).padStart(4, "0")}.webp`;

    function sizeCanvas() {
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(r.width * dpr);
      canvas.height = Math.round(r.height * dpr);
      current = -1;
      render();
    }

    function progress(): number {
      const r = el.getBoundingClientRect();
      const dist = el.offsetHeight - window.innerHeight;
      if (dist <= 0) return 0;
      // Film ist bei 90 % fertig, danach steht das Schlussbild noch kurz
      return Math.min(1, Math.max(0, -r.top / dist / 0.9));
    }

    function nearestLoaded(i: number) {
      for (let d = 0; d < count; d++) {
        if (frames[i - d]?.complete) return frames[i - d];
        if (frames[i + d]?.complete) return frames[i + d];
      }
      return null;
    }

    // "object-fit: cover" für Canvas
    function drawCover(img: HTMLImageElement) {
      const cw = canvas.width, ch = canvas.height;
      const s = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * s, h = img.naturalHeight * s;
      ctx!.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
    }

    function render() {
      ticking = false;
      const i = Math.round(progress() * (count - 1));
      if (i === current) return;
      const img = nearestLoaded(i);
      if (!img) return;
      current = frames[i]?.complete ? i : -1;
      drawCover(img);
      el.classList.add("is-live");
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    }

    // Erst jedes 4. Frame (grob scrubbar), dann den Rest
    function load() {
      const order: number[] = [];
      for (let i = 0; i < count; i += 4) order.push(i);
      for (let i = 0; i < count; i++) if (i % 4) order.push(i);
      let n = 0;
      const next = () => {
        const batch = order.slice(n, n + 6);
        n += 6;
        batch.forEach((i) => {
          const im = new Image();
          im.decoding = "async";
          im.onload = () => {
            if (i === 0) sizeCanvas();
            else if (current === -1) render();
          };
          im.src = src(i);
          frames[i] = im;
        });
        if (n < order.length) setTimeout(next, 50);
      };
      next();
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => requestAnimationFrame(sizeCanvas));
    const start = () =>
      "requestIdleCallback" in window ? (window as any).requestIdleCallback(load) : setTimeout(load, 200);
    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
  }

  document.querySelectorAll<HTMLElement>("[data-hss]").forEach(initHeroSequence);
</script>

<style is:global>
  .hss-section {
    position: relative;
    /* Header (sticky, 69-73px) liegt über dem Film -> Hero zieht darunter */
    margin-top: -73px;
    background: #050505;
  }
  .hss-pin {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 110px 0 80px;
  }
  .hss-bg {
    position: absolute;
    inset: 0;
  }
  .hss-poster,
  .hss-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hss-poster { object-fit: cover; }
  .hss-canvas { opacity: 0; }
  .hss-section.is-live .hss-canvas { opacity: 1; }
  .hss-section.is-live .hss-poster { visibility: hidden; }

  /* Lesbarkeit: links dunkel, unten weicher Übergang in die Seite */
  .hss-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(5, 5, 5, 0.82) 0%, rgba(5, 5, 5, 0.55) 38%, rgba(5, 5, 5, 0) 68%),
      linear-gradient(180deg, rgba(5, 5, 5, 0) 70%, var(--color-bg) 100%);
  }
  @media (max-aspect-ratio: 1/1) {
    .hss-scrim {
      background:
        linear-gradient(180deg, rgba(5, 5, 5, 0.2) 0%, rgba(5, 5, 5, 0.62) 40%, rgba(5, 5, 5, 0.45) 78%, var(--color-bg) 100%);
    }
  }

  /* Text im Film bleibt immer hell — auch im hellen Modus */
  .hss-content {
    --color-text: #f2f2f2;
    --color-text-muted: rgba(255, 255, 255, 0.78);
    --color-border: rgba(255, 255, 255, 0.16);
    --color-border-strong: rgba(255, 255, 255, 0.28);
    --color-bg-card: rgba(255, 255, 255, 0.06);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
  }
  html.a11y-light-mode .hss-content .text-gradient-light {
    background: linear-gradient(180deg, #ffffff 0%, #bbbbbb 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }
  html.a11y-light-mode .hss-content { --color-accent: #ff6b35; }

  /* Pinning nur mit Bewegung */
  @media (prefers-reduced-motion: no-preference) {
    .hss-section { height: 260vh; }
    .hss-section .hss-pin {
      position: sticky;
      top: 0;
      height: 100svh;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (max-aspect-ratio: 1/1) {
    .hss-section { height: 220vh; }
  }
</style>
