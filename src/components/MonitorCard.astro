---
/**
 * MonitorCard — Browser-Fenster-Optik mit Traffic-Lights und URL-Bar.
 * Wird sowohl auf Stadt-Landingpages (lokale Referenzen) als auch
 * auf der Referenzen-Übersichtsseite verwendet.
 *
 * Props:
 *   url      — Anzeige in der URL-Bar (ohne Protokoll, z. B. "renaissance-stadthagen.de")
 *   image    — Quelle des Vorschau-Bilds der "Screen"-Fläche
 *   alt      — Alt-Text für das Vorschau-Bild (SEO + a11y). Fallback aus URL.
 *   href     — Wohin verlinkt die Karte
 *   variant  — "compact" (Stadt-Seite) oder "default" (Referenzen, mit Hover-Zoom)
 *   mobileImage — optional: Mobil-Screenshot; blendet unten rechts ein
 *                 Smartphone-Mockup über den Monitor ein
 *
 * Wichtig (Mai 2026 Refactor): Das Vorschau-Bild wird jetzt als <img>-Tag
 * gerendert statt als CSS background-image. Damit kommt es in die Google-
 * Bildersuche und hat einen alt-Text für Screenreader.
 */
import { phoneSrc, phoneSrcset } from "../lib/phone";

interface Props {
  url: string;
  image: string;
  alt?: string;
  /** Wenn href fehlt: Karte wird als <div> gerendert (nicht klickbar). */
  href?: string;
  variant?: "compact" | "default";
  /** Optional: Mobil-Screenshot für das Smartphone-Mockup unten rechts. */
  mobileImage?: string;
  /** sizes-Attribut fürs Smartphone-Bild. Default passt zur Referenz-Übersicht
   *  (3 Spalten); die Detailseite übergibt einen größeren Wert. */
  phoneSizes?: string;
}

const {
  url,
  image,
  alt,
  href,
  variant = "default",
  mobileImage,
  phoneSizes = "(min-width: 1024px) 95px, (min-width: 640px) 80px, 85px",
} = Astro.props;
// Fallback-Alt aus der URL — besser als leer.
const imageAlt = alt ?? `Vorschau der Website ${url}`;
// Smartphone-Screenshot: drei vorab scharf skalierte Größen, damit der Browser
// nie stark herunterrechnen muss (das machte die kleine Darstellung unscharf).
const phoneImgSrc = mobileImage ? phoneSrc(mobileImage) : undefined;
const phoneImgSrcset = mobileImage ? phoneSrcset(mobileImage) : undefined;
---

{/*
  Die Karte ist IMMER ein <div>. Klickbar wird sie über einen flächendeckenden
  Overlay-Link („stretched link").

  Warum nicht einfach <a> außen herum (Stand bis 09.09.2026): Der Slot enthält
  auf der Referenzen-Übersicht den „Live ansehen"-Link. Ein <a> in einem <a> ist
  ungültiges HTML — der Browser bricht das äußere Element auf und erzeugt daraus
  mehrere Geschwister-Anchor. Sichtbar wurde das, sobald die ersten Referenzen
  featured wurden: Aus 3 Karten wurden 12 Fragmente, das Bild steckte nur noch im
  ersten davon. Genau deshalb darf hier nie wieder ein <a> außen stehen.
*/}
<div
  class:list={["monitor-card", variant, !href && "monitor-card--static", mobileImage && "has-phone"]}
  data-variant={variant}
>
  {href && (
    <a class="monitor-card__link" href={href} aria-label={`${imageAlt} — Case Study ansehen`}></a>
  )}
  <div class="monitor">
    <div class="monitor-top">
      <div class="traffic">
        <span class="red"></span>
        <span class="yellow"></span>
        <span class="green"></span>
      </div>
      <div class="url-bar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
        {url}
      </div>
    </div>
    <div class="screen">
      <img src={image} alt={imageAlt} loading="lazy" decoding="async" class="screen-img" />
      <div class="screen-glare"></div>
      <div class="screen-tint"></div>
    </div>
    {mobileImage && (
      <div class="phone" aria-hidden="true">
        <div class="phone-screen">
          <img
            src={phoneImgSrc}
            srcset={phoneImgSrcset}
            sizes={phoneSizes}
            alt=""
            width="360"
            height="779"
            loading="lazy"
            decoding="async"
          />
          <span class="phone-island"></span>
        </div>
      </div>
    )}
  </div>
  <div class="info">
    <slot />
  </div>
</div>

