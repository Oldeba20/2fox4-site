---
/**
 * „Fuchs & Federn“ — Schießbuden-Spiel der 404-Seite.
 * Spiel-Logik: src/scripts/arcade/fox-game.js, Fuchs-Grafik: fox-svg.js
 */
import { foxSVG } from "../../scripts/arcade/fox-svg.js";
const foxStart = foxSVG("happy", true);
---

<div class="fx" id="fox-game">
  <div class="fx-frame">
    <canvas class="fx-canvas" width="960" height="600" tabindex="0" aria-label="Spielfeld von Fuchs und Federn"></canvas>

    <button class="fx-scroll fx-scroll-l" type="button" data-fx-scroll="-1" aria-label="Nach links schwenken">‹</button>
    <button class="fx-scroll fx-scroll-r" type="button" data-fx-scroll="1" aria-label="Nach rechts schwenken">›</button>

    <div class="fx-ov" data-fx="start">
      <div class="fx-card">
        <div class="fx-card-fox" aria-hidden="true" set:html={foxStart} />
        <h2>Fuchs &amp; Federn</h2>
        <p class="fx-sub">
          Unser Fuchs hat Hunger, aber keine Flinte. Hilf ihm: 90&nbsp;Sekunden, 8&nbsp;Schuss pro Ladung.
        </p>
        <ul class="fx-rules">
          <li class="fx-fine"><b>Klick:</b> schießen · <b>Rechtsklick</b> oder <kbd>Leertaste</kbd>: nachladen</li>
          <li class="fx-coarse"><b>Tippen:</b> schießen · <b>Patronen</b> unten rechts antippen: nachladen</li>
          <li class="fx-fine"><b>Maus an den Rand</b> oder <kbd>A</kbd>&thinsp;<kbd>D</kbd>: Landschaft schwenken</li>
          <li class="fx-coarse"><b>Pfeile am Rand</b> gedrückt halten: Landschaft schwenken</li>
          <li>Hühner hinten <b>25</b>, in der Mitte <b>10</b>, vorne <b>5</b> Punkte. Goldenes Huhn: <b>50</b></li>
          <li>Versteckte Boni: Windmühle, Wegweiser, Vogelscheuche und Ballon</li>
          <li class="fx-warn">Den Fuchs hinter den Heuballen bitte nicht treffen: <b>−50</b></li>
        </ul>
        <p class="fx-portrait">Tipp: Halte dein Handy quer, dann wird das Spielfeld größer.</p>
        <button class="fx-btn fx-btn-primary" type="button" data-fx-action="start">▶&nbsp;Los geht’s</button>
      </div>
    </div>

    <div class="fx-ov" data-fx="pause" hidden>
      <div class="fx-card fx-card-small">
        <h2>Pause</h2>
        <button class="fx-btn fx-btn-primary" type="button" data-fx-action="resume">▶&nbsp;Weiterspielen</button>
      </div>
    </div>

    <div class="fx-ov" data-fx="end" hidden>
      <div class="fx-card fx-card-end">
        <img class="fx-endfox" data-fx="endfox" alt="" width="96" height="103" />
        <p class="fx-record" data-fx="record" hidden>Neuer Rekord!</p>
        <h2>Zeit ist um!</h2>
        <div class="fx-stats">
          <div><span data-fx="score">0</span><small>Punkte</small></div>
          <div><span data-fx="birds">0</span><small>Hühner</small></div>
          <div><span data-fx="acc">0 %</span><small>Trefferquote</small></div>
          <div><span data-fx="best">0</span><small>Rekord</small></div>
        </div>
        <p class="fx-line" data-fx="line"></p>
        <div class="fx-actions">
          <button class="fx-btn fx-btn-primary" type="button" data-fx-action="start">↻&nbsp;Nochmal</button>
          <button class="fx-btn fx-btn-ghost" type="button" data-arcade-back>Anderes Spiel</button>
          <a class="fx-btn fx-btn-ghost" href="/">Zur Startseite</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initFoxGame } from "../../scripts/arcade/fox-game.js";
  initFoxGame(document.getElementById("fox-game"));
</script>

<style>
  .fx { width: 100%; display: flex; justify-content: center; }
  .fx-frame {
    position: relative;
    width: 100%;
    max-width: 960px;
    aspect-ratio: 8 / 5;
    border-radius: 12px;
    overflow: hidden;
    background: #161733;
    box-shadow: 0 25px 60px -20px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
  }
  .fx-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: none;
    outline: none;
    touch-action: none;
  }

  .fx-scroll {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 72px;
    border: 0;
    border-radius: 10px;
    background: rgba(10, 10, 10, 0.45);
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    z-index: 2;
    touch-action: none;
  }
  .fx-scroll-l { left: 6px; }
  .fx-scroll-r { right: 6px; }
  .fx-scroll:active { background: rgba(255, 107, 53, 0.7); }

  .fx-ov {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: safe center;
    justify-content: center;
    padding: 1rem;
    overflow-y: auto;
    background: radial-gradient(ellipse at 50% 60%, rgba(22, 23, 51, 0.55), rgba(10, 8, 20, 0.88));
    backdrop-filter: blur(3px);
  }
  .fx-ov[hidden] { display: none; }

  .fx-card {
    position: relative;
    width: 100%;
    max-width: 30rem;
    margin: auto;
    padding: 1.1rem 1.4rem 1.2rem;
    border-radius: 16px;
    background: #17131f;
    border: 1px solid rgba(255, 107, 53, 0.35);
    box-shadow: 0 0 0 4px rgba(255, 107, 53, 0.08), 0 20px 50px -10px rgba(0, 0, 0, 0.7);
    color: #f5efe6;
    text-align: center;
  }
  .fx-card-small { max-width: 18rem; }
  .fx-card-fox {
    width: 84px;
    margin: -0.2rem auto 0.1rem;
    animation: fx-bob 2.4s ease-in-out infinite;
  }
  .fx-card-fox :global(svg) { width: 100%; height: auto; display: block; }
  @keyframes fx-bob {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-5px) rotate(3deg); }
  }
  .fx-card h2 {
    margin: 0 0 0.35rem;
    font-size: 1.45rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .fx-sub { margin: 0 0 0.75rem; font-size: 0.92rem; color: #d9cfc2; }
  .fx-rules {
    list-style: none;
    margin: 0 0 0.9rem;
    padding: 0.65rem 0.8rem;
    display: grid;
    gap: 0.3rem;
    text-align: left;
    font-size: 0.82rem;
    color: #d9cfc2;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 10px;
  }
  .fx-rules li { padding-left: 1rem; position: relative; }
  .fx-rules li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ff6b35;
  }
  .fx-rules b { color: #fff; }
  .fx-warn b { color: #ff8a80; }
  .fx-card kbd {
    font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    font-size: 0.78em;
    padding: 0 5px;
    border-radius: 4px;
    border: 1px solid #4a4150;
    border-bottom-width: 2px;
    background: #2a2330;
    color: #fff;
  }
  .fx-coarse, .fx-portrait { display: none; }
  .fx-portrait { font-size: 0.8rem; color: #ffd89a; margin: -0.3rem 0 0.8rem; }

  .fx-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.62rem 1.2rem;
    border-radius: 999px;
    font: inherit;
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition: transform 0.12s, background 0.15s, box-shadow 0.15s;
  }
  .fx-btn:hover { transform: translateY(-1px); }
  .fx-btn:focus-visible { outline: 3px solid #ffe600; outline-offset: 2px; }
  .fx-btn-primary {
    background: linear-gradient(180deg, #ff7a45, #ff5a1f);
    color: #fff;
    box-shadow: 0 6px 18px -6px rgba(255, 107, 53, 0.8);
  }
  .fx-btn-primary:hover { box-shadow: 0 8px 24px -6px rgba(255, 107, 53, 1); }
  .fx-btn-ghost { background: transparent; color: #f5efe6; border-color: rgba(255, 255, 255, 0.25); }
  .fx-btn-ghost:hover { background: rgba(255, 255, 255, 0.08); }

  .fx-endfox { display: block; margin: -0.3rem auto 0.2rem; width: 86px; height: auto; }
  .fx-record {
    display: inline-block;
    margin: 0 0 0.3rem;
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    background: #ffe600;
    color: #111;
    font-weight: 900;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    animation: fx-pop 0.6s ease-out;
  }
  .fx-record[hidden] { display: none; }
  @keyframes fx-pop { 0% { transform: scale(0.4); } 70% { transform: scale(1.15); } 100% { transform: scale(1); } }
  .fx-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
    margin: 0.5rem 0 0.7rem;
  }
  .fx-stats div {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.2rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
  }
  .fx-stats span {
    font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    font-weight: 900;
    font-size: 1.3rem;
    color: #fff;
  }
  .fx-stats div:first-child span { color: #ff6b35; }
  .fx-stats small { font-size: 0.68rem; color: #b3a89b; text-transform: uppercase; letter-spacing: 0.06em; }
  .fx-line { margin: 0 0 0.8rem; font-size: 0.92rem; color: #d9cfc2; font-style: italic; }
  .fx-actions { display: flex; flex-wrap: wrap; gap: 0.45rem; justify-content: center; }

  @media (pointer: coarse) {
    .fx-scroll { display: block; }
    .fx-fine { display: none; }
    .fx-coarse { display: list-item; }
  }
  @media (pointer: coarse) and (orientation: portrait) {
    .fx-portrait { display: block; }
  }
  @media (max-width: 640px) {
    .fx-ov { padding: 0.5rem; align-items: flex-start; }
    .fx-card { padding: 0.8rem 0.9rem 0.9rem; border-radius: 12px; }
    .fx-card-fox { width: 58px; }
    .fx-card h2 { font-size: 1.15rem; }
    .fx-sub { font-size: 0.82rem; margin-bottom: 0.5rem; }
    .fx-rules { font-size: 0.74rem; padding: 0.5rem 0.6rem; }
    .fx-stats { grid-template-columns: repeat(2, 1fr); }
    .fx-stats span { font-size: 1.05rem; }
    .fx-endfox { width: 60px; }
  }
</style>
